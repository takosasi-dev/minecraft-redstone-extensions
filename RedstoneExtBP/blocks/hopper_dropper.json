{
  "format_version": "1.26.20",
  "minecraft:block": {
    "description": {
      "identifier": "wr:hopper_dropper",
      "menu_category": {
        "category": "items",
        "group": "wr:itemGroup.name.redstone_ext"
      },
      "states": {
        "wr:busy": [
          false,
          true
        ],
        "wr:powered": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:display_name": "tile.wr:hopper_dropper.name",
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.6
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "wr_hopper_dropper_side",
          "render_method": "opaque"
        },
        "up": {
          "texture": "wr_hopper_dropper_top",
          "render_method": "opaque"
        }
      },
      "minecraft:redstone_conductivity": {
        "redstone_conductor": true,
        "allows_wire_to_step_down": true
      },
      "minecraft:redstone_consumer": {
        "min_power": 0,
        "propagates_power": false
      },
      "wr:hopper_dropper": {},
      "minecraft:tick": {
        "interval_range": [
          4,
          4
        ],
        "looping": true
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('wr:busy') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "wr_hopper_dropper_side",
              "render_method": "opaque"
            },
            "up": {
              "texture": "wr_hopper_dropper_top",
              "render_method": "opaque"
            }
          }
        }
      },
      {
        "condition": "q.block_state('wr:busy') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "wr_hopper_dropper_side",
              "render_method": "opaque"
            },
            "up": {
              "texture": "wr_hopper_dropper_top_on",
              "render_method": "opaque"
            }
          }
        }
      }
    ]
  }
}
